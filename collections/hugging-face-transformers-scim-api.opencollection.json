              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new user in the organization. If the user already exists, only `active` field will be updated to provision the user."
        },
        {
          "info": {
            "name": "Get a SCIM user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://huggingface.co/api/organizations/:name/scim/v2/Users/:userId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a SCIM user by their ID."
