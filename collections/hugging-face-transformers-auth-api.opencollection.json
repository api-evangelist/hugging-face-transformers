{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hub API Endpoints agentic-provisioning auth API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://huggingface.co/api/whoami-v2"
          },
          "docs": "Get information about the user and auth method used"
        }
      ]
    }
  ],
  "bundled": true
}