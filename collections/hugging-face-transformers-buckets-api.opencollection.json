{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hub API Endpoints agentic-provisioning buckets API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
